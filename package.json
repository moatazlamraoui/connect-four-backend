{
  "name": "connect-four-exam-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Connect Four REST backend for the Advanced Programming exam",
  "main": "dist/src/server.js",
  "scripts": {
    "generate:keys": "node scripts/generate-keys.js",
    "generate:keys:if-missing": "node scripts/generate-keys.js --if-missing",
    "predev": "npm run generate:keys:if-missing",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run generate:keys:if-missing",
    "start": "node dist/src/server.js",
    "seed": "ts-node scripts/seed.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect4-ai": "^0.1.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.16.0",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7",
    "zod": "^3.24.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "@types/cors": "^2.8.17"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true
  }
}
