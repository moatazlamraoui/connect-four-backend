@startuml
actor User
participant "Express Router" as Router
participant "JWT Middleware" as Auth
participant "GameService" as Service
participant "ConnectFourEngineAdapter" as Engine
participant "SQLite" as DB

User -> Router: POST /api/games/{id}/moves
Router -> Auth: authenticate JWT
Auth -> DB: find user
DB --> Auth: User
Auth --> Router: authenticated user
Router -> Service: makeMove(gameId,userId,column)
Service -> DB: load game and move history
Service -> Engine: validateColumn(history,column)
Engine --> Service: legal move
Service -> DB: insert move and debit 0.05
alt HUMAN_VS_AI and human move does not end game
  Service -> Engine: chooseAiColumn(history,difficulty)
  Engine --> Service: AI column
  Service -> DB: insert AI move and debit 0.05 to human account
end
Service -> DB: update board, turn, winner or draw
DB --> Service: updated game
Service --> Router: game state
Router --> User: 200 OK + JSON
@enduml
