@startuml
actor User
participant "Express Router" as Router
participant "JWT Middleware" as Auth
participant "Validation Middleware" as Validate
participant "GameService" as Service
participant "Sequelize / SQLite" as DB

User -> Router: POST /api/games + Bearer JWT
Router -> Auth: authenticate token
Auth -> DB: find user by JWT sub
DB --> Auth: User
Auth --> Router: req.user
Router -> Validate: validate create-game body
Validate --> Router: validated input
Router -> Service: createGame(userId, input)
Service -> DB: check current credits
Service -> DB: check active game for creator/opponent
Service -> DB: deduct 0.45 or 0.75
Service -> DB: insert Game
DB --> Service: Game
Service --> Router: game state
Router --> User: 201 Created + JSON
@enduml
