NODE_ENV=development
PORT=3000
DB_STORAGE=./data/connect-four.sqlite

# RS256 key pair. Leave empty and run "npm run generate:keys" (done automatically by "npm run dev").
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRES_IN=2h

# Starting credit given to every seeded / registered user
INITIAL_CREDITS=10.00

# Seed accounts (npm run seed). Change them freely BEFORE seeding; min 8 characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Adm1n!Forza4-Secure
SEED_ALICE_EMAIL=alice@example.com
SEED_ALICE_PASSWORD=Al1ce!Forza4-Play
SEED_BOB_EMAIL=bob@example.com
SEED_BOB_PASSWORD=B0b!Forza4-Play

CORS_ORIGIN=*
